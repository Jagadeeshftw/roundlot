# Payments (X Layer testnet by default; eip155:196 is configured but disabled)
PAYMENT_NETWORK=eip155:1952
PAY_TO=0x...

# Facilitator: "okx" (OKX facilitator, needs Developer Portal credentials)
# or "local" (in-process facilitator; RELAYER_PRIVATE_KEY pays settlement gas)
FACILITATOR=okx
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# RELAYER_PRIVATE_KEY=0x...

PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Demo buyer: scripts, and the deployed service when TRY_IT_ENABLED=true
# DEMO_BUYER_PRIVATE_KEY=0x...

# Landing-page "Try it" (off by default): the demo wallet pays for one quote per click
TRY_IT_ENABLED=false
TRY_IT_DAILY_CAP=200
CORS_ORIGINS=https://roundlot.0xo.in,http://localhost:3001
