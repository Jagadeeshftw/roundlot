{
  "name": "@roundlot/service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:live": "LIVE=1 vitest run test/quote.live.test.ts",
    "test:fork": "FORK=1 vitest run test/planTrade.fork.test.ts",
    "demo": "tsx --env-file-if-exists=../.env scripts/demo-agent.ts",
    "demo:okx": "tsx --env-file-if-exists=../.env scripts/demo-okx.ts",
    "warm": "tsx --env-file-if-exists=../.env scripts/warm.ts",
    "check:prod": "tsx --env-file-if-exists=../.env scripts/check-prod.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@okxweb3/app-x402-core": "0.2.0",
    "@okxweb3/app-x402-evm": "0.2.0",
    "@okxweb3/app-x402-express": "0.2.0",
    "@okxweb3/app-x402-fetch": "0.1.2",
    "express": "5.2.1",
    "viem": "2.56.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
